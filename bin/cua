#!/bin/bash
# cua start   - start the agent (model server + agent service + input), ready for phone and `cua`
# cua stop    - stop everything and free the GPU
# cua status  - show what's running
# cua [msg]   - chat with the agent in this terminal (same session as the phone app)
UNITS="ydotool.service llama-router.service cua.service"

case "${1:-}" in
  start)
    [ $# -eq 1 ] || exec python3 ~/cua/client.py "$@"
    systemctl --user start $UNITS
    for i in $(seq 30); do curl -sf http://127.0.0.1:8765/manifest.webmanifest >/dev/null && curl -sf http://127.0.0.1:8080/health >/dev/null && break; sleep 1; done
    if curl -sf http://127.0.0.1:8765/manifest.webmanifest >/dev/null && curl -sf http://127.0.0.1:8080/health >/dev/null; then
      echo "CUA is running. Phone: open the CUA app (Tailscale connected). PC: run 'cua'."
      echo "The model loads into the GPU on the first task. Stop with: cua stop"
    else
      echo "CUA did not start:"; journalctl --user -u cua -n 15 --no-pager
    fi ;;
  stop)
    [ $# -eq 1 ] || exec python3 ~/cua/client.py "$@"
    systemctl --user stop cua.service llama-router.service ydotool.service
    sleep 1
    echo "CUA stopped. GPU memory in use now: $(nvidia-smi --query-gpu=memory.used --format=csv,noheader 2>/dev/null)" ;;
  status)
    [ $# -eq 1 ] || exec python3 ~/cua/client.py "$@"
    for u in $UNITS; do printf '  %-22s %s\n' "$u" "$(systemctl --user is-active $u)"; done
    echo "  GPU memory in use:     $(nvidia-smi --query-gpu=memory.used --format=csv,noheader 2>/dev/null)" ;;
  *)
    exec python3 ~/cua/client.py "$@" ;;
esac
